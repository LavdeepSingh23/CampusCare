# ==============================================================================
# CampusCare Backend Environment Configuration
# ==============================================================================

# Application Environment ('development', 'production', or 'test')
ENVIRONMENT=development

# Database Mode ('mysql' or 'sqlite')
# - mysql: Production/staging standard connecting to Aiven MySQL with TLS.
# - sqlite: Local offline development sandbox. STRICTLY FORBIDDEN in production.
DB_MODE=mysql

# MySQL / Aiven Connection Settings
DB_HOST=campuscare-db-campuscare23.h.aivencloud.com
DB_PORT=11141
DB_NAME=campuscare_dev
DB_USER=campuscare_dev
DB_PASSWORD=your_aiven_password_here

# TLS / SSL Settings for MySQL
# Options: REQUIRED (TLS encryption), VERIFY_CA, VERIFY_IDENTITY, DISABLED
DB_SSL_MODE=REQUIRED
DB_SSL_CA=
DB_CONNECT_TIMEOUT=10

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth (Student Verification)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173